<resources>
 <style name="RavenTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#64C895</item><item name="android:colorBackground">#131519</item><item name="android:windowBackground">#131519</item><item name="android:textColorPrimary">#F1F2F6</item><item name="android:textColorSecondary">#A9B0BC</item><item name="android:colorControlNormal">#A9B0BC</item><item name="android:alertDialogTheme">@style/RavenDialog</item><item name="android:popupTheme">@style/RavenDialog</item><item name="android:windowLightStatusBar">false</item>
