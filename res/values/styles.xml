 </style>
 <style name="RavenDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
  <item name="android:colorAccent">#267449</item><item name="android:colorBackground">#FFFFFF</item><item name="android:textColorPrimary">#20232B</item><item name="android:textColorSecondary">#586171</item><item name="android:colorControlNormal">#586171</item><item name="android:windowMinWidthMajor">55%</item><item name="android:windowMinWidthMinor">90%</item>
